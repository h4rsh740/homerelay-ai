# HomeRelay AI Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from https://app.supabase.com → Project → Settings → API
# The service-role key is server-only. Never use it in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Get Gemini key from https://aistudio.google.com/app/apikey (free tier available)
# Get OpenAI key from https://platform.openai.com/api-keys
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ─── MCP Server ──────────────────────────────────────────────────────────────
# The URL where the MCP server is running (locally: port 3001)
MCP_SERVER_URL=http://localhost:3001/mcp
# A long random string used to authenticate requests between Next.js and MCP
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SERVER_SECRET=change-me-to-a-random-string

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HomeRelay AI
NODE_ENV=development
